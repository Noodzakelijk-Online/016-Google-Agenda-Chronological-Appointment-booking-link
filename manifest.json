{
  "manifest_version": 3,
  "name": "Appointment Duration Sorter",
  "version": "1.2.0",
  "description": "Sorts appointment choices from shortest to longest duration without changing calendar events.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.noodzakelijkonline.nl/*",
        "*://calendar.google.com/calendar/selfsched*",
        "*://calendar.google.com/calendar/appointments/*",
        "*://calendar.google.com/calendar/*/appointment*",
        "*://calendar.app.google/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "*://*.noodzakelijkonline.nl/*",
    "*://calendar.google.com/calendar/selfsched*",
    "*://calendar.google.com/calendar/appointments/*",
    "*://calendar.google.com/calendar/*/appointment*",
    "*://calendar.app.google/*"
  ]
}
